# Relative (same-origin) API base URLs for production. vercel.json rewrites
# /api/* on this app's own domain to the real backend, so the browser never
# makes a cross-origin request and no CORS handling is needed on the backend.
# (Empty string, not unset — the code's `?? 'http://localhost:...'` fallback
# only kicks in for null/undefined, and an empty string isn't either.)
VITE_ADMIN_SERVICE_URL=
VITE_AUTH_SERVICE_URL=
VITE_USER_SERVICE_URL=
VITE_DRIVER_SERVICE_URL=
VITE_BUS_SERVICE_URL=
VITE_BOOKING_SERVICE_URL=
VITE_PAYMENT_GATEWAY_URL=
VITE_PAYMENT_HUB_URL=
VITE_WALLET_SERVICE_URL=
VITE_NOTIFICATION_SERVICE_URL=
VITE_REWARD_SERVICE_URL=
VITE_TERMS_SERVICE_URL=
